#![enable(implicit_some)]
// Scout bot — wheels + melee blades
(
    templates: {
        "wheel": (
            shape: Cylinder(radius: 0.18, height: 0.1),
            color: (0.25, 0.25, 0.28),
            orient: X,
        ),
        "arm": (
            shape: Box(size: (0.12, 0.2, 0.12)),
            color: (0.25, 0.25, 0.28),
            pivot: (0.0, -0.1, 0.0),
        ),
        "blade": (
            shape: Box(size: (0.06, 0.5, 0.04)),
            color: (0.6, 0.25, 0.25),
        ),
    },

    root: (
        name: "root",
        children: [
            // Chassis
            (
                name: "chassis",
                shape: Box(size: (0.7, 0.35, 0.5)),
                at: (0.0, 0.55, 0.0),
                color: (0.45, 0.45, 0.50),
            ),
            // Head / sensor dome
            (
                name: "head",
                at: (0.0, 0.851, 0.0),
                shape: Sphere(radius: 0.18),
                color: (0.55, 0.55, 0.60),
                children: [
                    (
                        name: "eye",
                        shape: Sphere(radius: 0.06),
                        at: (0.0, 0.0, 0.15),
                        color: (0.9, 0.2, 0.1),
                        emissive: true,
                    ),
                ],
            ),
            // Arms + blades — mirrored across X
            (
                mirror: X,
                children: [
                    (
                        name: "arm",
                        template: "arm",
                        at: (0.41, 0.675, 0.0),
                        children: [
                            (
                                name: "blade",
                                template: "blade",
                                at: (0.0, -0.25, 0.0),
                            ),
                        ],
                    ),
                ],
            ),
            // Wheels — mirrored across X, front and back
            (
                mirror: X,
                children: [
                    (
                        name: "wheel_front",
                        template: "wheel",
                        at: (0.30, 0.18, 0.25),
                    ),
                    (
                        name: "wheel_back",
                        template: "wheel",
                        at: (0.30, 0.18, -0.25),
                    ),
                ],
            ),
        ],
    ),

    animations: [
        // Idle — subtle head bob
        (
            name: "idle",
            channels: [
                (part: "head", property: Translation, motion: Bob(amplitude: 0.01, freq: 2.0), axis: Y),
            ],
        ),
        // Walk — arms swing, wheels spin, chassis bobs
        (
            name: "walk",
            channels: [
                // Arm swing (opposite phase for mirrored arm)
                (part: "arm", property: Rotation, motion: Oscillate(amplitude: 0.3, speed: 10.0, offset: 0.0), axis: X),
                (part: "arm_mirrored", property: Rotation, motion: Oscillate(amplitude: 0.3, speed: 10.0, offset: 3.14159), axis: X),
                // Wheel spin
                (part: "wheel_front", property: Rotation, motion: Spin(rate: 8.0), axis: Y),
                (part: "wheel_back", property: Rotation, motion: Spin(rate: 8.0), axis: Y),
                (part: "wheel_front_mirrored", property: Rotation, motion: Spin(rate: 8.0), axis: Y),
                (part: "wheel_back_mirrored", property: Rotation, motion: Spin(rate: 8.0), axis: Y),
                // Chassis bob
                (part: "chassis", property: Translation, motion: Oscillate(amplitude: 0.01, speed: 20.0, offset: 0.0), axis: Y),
                // Head bob
                (part: "head", property: Translation, motion: Oscillate(amplitude: 0.015, speed: 20.0, offset: 0.0), axis: Y),
            ],
        ),
    ],
)
